// =====================================================================
//  Segway Ninebot Max G3 - 20s4p 21700 cell holder (EVE 40P) + BMS dock
//  Pack envelope 141 x 270 x 81 mm, fits in front of the deck divider,
//  the BMS stands upright on the other side of the divider, held by an
//  arm that is part of the TOP holder half and reaches over the divider.
//
//  Cell layout and copper pieces come from layout_data.scad, generated by
//  ../generator/layout.py.
//
//  Coordinates: x = 270 mm length, x = 0 is the DIVIDER end of the pack
//               (the divider is x = -div_w .. 0, the BMS is at x < -div_w)
//               y = 141 mm width,  y = 0 is the side wall the screw post
//                                   is measured from (80 mm)
//               z = height,         z = 0 is the deck floor
//
//  Parts (set `part`, or run export.sh):
//    holder_bottom, holder_top             cell holder halves (the top one carries the BMS dock)
//    holder_bottom_a/_b, holder_top_a/_b   same, split for beds < 270 mm
//    assembly                              everything in place (preview only)
// =====================================================================
include <layout_data.scad>

part = "assembly";

/* [Cell] */
cell_d      = 21.15;  // EVE 40P datasheet: 21.15 +-0.10
cell_len    = 70.6;   // 70.15 +0.15 max + fish-paper ring + margin
cell_bore   = 21.2;   // socket bore, picked with the fit test strip (1.0 mm web at 22.2 pitch). Also in layout.py
window_d    = 17.0;   // opening in the end stop over every cell. Also in layout.py

/* [Holder] */
cell_recess = 0.6;    // cells sit this far below the holder face (= end-stop lip, 3 layers)
sock        = 9.0;    // socket depth per half
void_d      = 10.0;   // lightening pocket in the empty end spots of the short rows
tie_w       = 4.6;    // zip-tie slot through the end wall (fits 3.6 mm ties)
tie_h       = 2.0;

/* [Screw post] */
post_clear  = 1.0;    // radial clearance
post_extra  = 1.0;    // height clearance

/* [Deck] */
div_w       = 10.0;   // divider width (x)
div_h       = 20.0;   // divider height
post_side   = "bms";  // "bms": post is on the BMS side of the divider, "pack": on the cell side

/* [BMS dock - ANT BMS 24ZHE6-24S-220A, built into the TOP holder half] */
bms_dock    = true;
bms_l       = 125;    // BMS length
bms_w       = 90;     // BMS width at the connector (head) end = height when standing
bms_body_w  = 70;     // width of the narrow section the power leads come out of
bms_head_l  = 50;     // length of the wide head section (balance connectors on its end)
bms_t       = 16;     // BMS thickness
bms_y       = 70.5;   // centre of the BMS across the deck (y)
bms_head_at = "y1";   // which deck side the connector end faces: "y0" or "y1"
bms_slot    = 0.4;    // clearance in the slot (thickness and length)
dock_rail   = 6;      // width of the outer rail of the slot
dock_end    = 3;      // cross bar that closes the slot at the narrow end
lead_notch  = 8;      // notches at the pack end the B-/B+ tongues fold down through

/* [Fit test strip] */
test_bores  = [21.1, 21.2, 21.3, 21.4, 21.5, 21.6];   // hole sizes to try

/* [Quality] */
$fn = 48;

// ---------------------------------------------------------------------
L = pack_l;
W = pack_w;
half_h   = cell_recess + sock;
total_h  = cell_len + 2 * cell_recess;
gap_h    = cell_len - 2 * sock;
post_d   = post[2];
post_h   = post[3];
// screw post position: measured from the divider face on its own side
post_xy  = post_side == "pack" ? [post[0], post[1]] : [-div_w - post[0], post[1]];
tie_z    = half_h - 2.5 - tie_h;   // tie slot (local z)
// BMS dock: the BMS stands on the floor just behind the screw post
bms_xn   = post_side == "bms" ? post_xy[0] - post_d / 2 - post_clear - 1 : -div_w - 1;   // near face
bms_xf   = bms_xn - bms_t;                                                              // far face
bms_y0   = bms_y - bms_l / 2;
bms_y1   = bms_y + bms_l / 2;
narrow_y1 = bms_head_at == "y0";   // the narrow end (closed by the cross bar) is at y1
echo(str("PACK HEIGHT = ", total_h, " mm + copper/nickel/insulation (limit 81)  gap between halves = ", gap_h));
assert(total_h <= 78, "pack too tall for 81 mm with copper and insulation");

// ---------------------------------------------------------------------
// 2D helpers
// ---------------------------------------------------------------------
module outline() { square([L, W]); }

module split_mask(which, face = "bottom") {
    // which: "all", "a", "b"   (zig-zag split between cells)
    // (the BMS dock at x < 0 belongs to part "a")
    sa = face == "top" ? split_a_top : split_a;   // the two halves split at different columns
    if (which == "a") union() { polygon(sa); translate([-200, -1]) square([200.01, W + 2]); }
    else if (which == "b") difference() { translate([0, -1]) square([L + 1, W + 2]); polygon(sa); }
    else translate([-200, -1]) square([L + 201, W + 2]);
}

module bores()   { for (c = cells) translate([c[0], c[1]]) circle(d = cell_bore); }
module windows() { for (c = cells) translate([c[0], c[1]]) circle(d = window_d); }
module chase2d() { translate(chase) circle(d = cell_bore); }
module post2d()  {   // open towards the divider end so it never grazes the wall
    hull() for (dx = [0, -post_xy[0] - 1]) translate(post_xy + [dx, 0]) circle(d = post_d + 2 * post_clear);
}
module voids()   { for (v = concat(voids_x0, voids_x1)) translate(v) circle(d = void_d); }
function in_notch(y) = len([for (l = leads) if (abs(y - l[0]) < l[2] / 2) 1]) > 0;
module tie_slots(face) {
    // lead strain-relief slots through the end wall; on the top half with
    // the dock only those that open into a lead notch stay
    for (v = voids_x0) if (!(face == "top" && bms_dock) || in_notch(v[1]))
        translate([-1, v[1] - tie_w / 2]) square([v[0], tie_w]);
}

// BMS dock outline (world xy, x < 0): solid bridge over the divider up to
// the slot, outer rail beyond it, cross bar at the narrow end, notches for
// the lead tongues, zip-tie hole pairs for the BMS straps and the leads.
module dock2d() {
    s  = bms_slot / 2;
    yl = narrow_y1 ? bms_y0 - s : bms_y0 - s - dock_end;
    yh = narrow_y1 ? bms_y1 + s + dock_end : bms_y1 + s;
    xr = bms_xf - s - dock_rail;                  // outer edge of the rail
    module pair(x, y, along_x = false) {          // two tie holes 7 mm apart
        for (d = [-3.5, 3.5])
            translate(along_x ? [x + d, y] : [x, y + d])
                square(along_x ? [tie_h, tie_w] : [tie_h, tie_w], center = true);
    }
    difference() {
        union() {
            translate([bms_xn + s, yl]) square([-bms_xn - s + 0.01, yh - yl]);   // bridge
            translate([xr, yl]) square([dock_rail, yh - yl]);                    // outer rail
            translate([xr, narrow_y1 ? bms_y1 + s : yl]) square([bms_xn + s - xr, dock_end]);
        }
        for (l = leads) translate([-lead_notch, l[0] - l[2] / 2 - 1]) square([lead_notch + 1, l[2] + 2]);
        // BMS straps: hole pairs in both rails near each end of the BMS
        for (y = [bms_y0 + 18, bms_y1 - 18]) {
            pair(bms_xn + s + 2.5, y);
            pair(xr + dock_rail / 2, y);
        }
        // lead straps: hole pair beside each notch
        for (l = leads) for (d = [-1, 1])
            translate([-lead_notch - 3.5, l[0] + d * (l[2] / 2 + 4)]) square([tie_h, tie_w], center = true);
    }
}

// 3D slab: linear_extrude a 2D region between z0 and z1
module slab(z0, z1) { translate([0, 0, z0]) linear_extrude(z1 - z0) children(); }

// ---------------------------------------------------------------------
// Holder half. Local coords: z = 0 is the outer face (copper side),
// xy = world xy. Print in this orientation (face down, no supports).
// The cells stop against a thin lip, cell_recess below the face, so the
// punched copper + nickel only has to dip cell_recess to reach the cell.
// ---------------------------------------------------------------------
module holder_half(face = "bottom", which = "all") {
    zs = cell_recess;             // sockets start
    zt = half_h;                  // inner end
    pocket = face == "bottom" && post_side == "pack";
    zp = pocket ? min(zt, post_h + post_extra) : -1;

    module socket_layer(cut_post, cut_tie) {
        intersection() {
            split_mask(which, face);
            difference() {
                outline();
                bores();
                chase2d();
                voids();
                if (cut_post) post2d();
                if (cut_tie) tie_slots(face);
            }
        }
    }

    union() {
        // end-stop lip with welding windows
        slab(0, zs) intersection() {
            split_mask(which, face);
            difference() {
                outline();
                windows();
                chase2d();
                if (pocket) post2d();
            }
        }
        // BMS dock arm (top half only), same thickness as the half
        if (face == "top" && bms_dock)
            slab(0, half_h) intersection() { split_mask(which, face); dock2d(); }
        // sockets, split into z-bands for the post pocket and the tie slots
        zl = [zs, max(zs, min(zp, tie_z)), tie_z, tie_z + tie_h, max(tie_z + tie_h, zt)];
        for (i = [0 : 3]) {
            z0 = zl[i]; z1 = zl[i + 1];
            if (z1 - z0 > 0.01)
                slab(z0, z1) socket_layer(pocket && z0 < zp, i == 2);
        }
    }
}

// ---------------------------------------------------------------------
// The BMS itself, standing on its long edge (preview only)
// ---------------------------------------------------------------------
module bms_shape() {
    body_z0 = (bms_w - bms_body_w) / 2;
    translate([bms_xf, 0, 0]) {
        translate([0, narrow_y1 ? bms_y0 : bms_y1 - bms_head_l, 0]) cube([bms_t, bms_head_l, bms_w]);
        translate([0, narrow_y1 ? bms_y0 + bms_head_l : bms_y0, body_z0]) cube([bms_t, bms_l - bms_head_l, bms_body_w]);
    }
}

// ---------------------------------------------------------------------
// Assembly preview (cells, copper, parts in place)
// ---------------------------------------------------------------------
module copper(face) {
    pcs = face == "top" ? top_copper : bottom_copper;
    for (i = [0 : len(pcs) - 1])
        color(i % 2 ? "#d9822b" : "#b5651d") linear_extrude(0.3) polygon(pcs[i]);
}

module assembly(explode = 0) {
    zc0 = cell_recess;     // cell bottom
    color("#555") translate([0, 0, -explode]) holder_half("bottom");
    translate([0, 0, -0.3 - explode * 1.5]) copper("bottom");
    for (c = cells)
        color(c[3] == "+" ? "#2e8b57" : "#2f4f4f")
            translate([c[0], c[1], zc0]) cylinder(d = cell_d, h = cell_len, $fn = 32);
    translate([0, 0, total_h + explode * 1.5]) copper("top");
    color("#555") translate([0, 0, total_h + explode]) mirror([0, 0, 1]) holder_half("top");
    if (bms_dock) color("#bbb", 0.7) bms_shape();
    // deck divider and screw post for reference
    color("#aa3333", 0.6) translate([-div_w, 0, 0]) cube([div_w, W, div_h]);
    color("#aa3333", 0.6) translate([post_xy[0], post_xy[1], 0]) cylinder(d = post_d, h = post_h);
}

// ---------------------------------------------------------------------
if (part == "holder_bottom")   holder_half("bottom");
if (part == "holder_bottom_a") holder_half("bottom", "a");
if (part == "holder_bottom_b") holder_half("bottom", "b");
if (part == "holder_top")      holder_half("top");
if (part == "holder_top_a")    holder_half("top", "a");
if (part == "holder_top_b")    holder_half("top", "b");
// ---------------------------------------------------------------------
// Fit test strip: one row of holes, same lip / depth / pitch as the
// holder, each a different size, the size raised on a tab next to it.
// Push a cell into each and pick the one that is firm but goes in by hand.
// ---------------------------------------------------------------------
module bore_test() {
    n = len(test_bores);
    wall = 2;
    w = (n - 1) * pitch + 2 * (pitch / 2 + wall - (pitch - max(test_bores)) / 2);
    x0 = w / 2 - (n - 1) * pitch / 2;
    dep = max(test_bores) + 2 * wall;
    difference() {
        union() {
            cube([w, dep, half_h]);
            translate([0, -9, 0]) cube([w, 9.01, 1.2]);          // label tab
        }
        for (i = [0 : n - 1]) translate([x0 + i * pitch, dep / 2, 0]) {
            translate([0, 0, cell_recess]) cylinder(d = test_bores[i], h = half_h);   // same $fn as the holder bores
            translate([0, 0, -1]) cylinder(d = window_d, h = cell_recess + 2);
        }
    }
    for (i = [0 : n - 1]) translate([x0 + i * pitch, -4.5, 1.2])
        linear_extrude(0.8) text(str(test_bores[i]), size = 4.2, halign = "center", valign = "center",
                                 font = "DejaVu Sans:style=Bold");
}

if (part == "bore_test")       bore_test();
if (part == "split_view") {   // documentation: the two print parts of a half
    color("#3a7bd5") holder_half("bottom", "a");
    color("#f58231") translate([0, 0, 0.01]) holder_half("bottom", "b");
}
if (part == "assembly")        assembly();
if (part == "exploded")        assembly(20);
